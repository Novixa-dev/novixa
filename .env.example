# ==============================================================================
# Novixa Environment Template (.env.example)
# Copy to .env.local for local development. Never commit real secret values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Public site origin — REQUIRED IN PRODUCTION.
# ------------------------------------------------------------------------------
# Drives canonical URLs, hreflang alternates, the sitemap, robots.txt, JSON-LD
# identifiers and every Open Graph / Twitter card URL.
#
# Set this to the domain visitors actually reach. If it is unset, the app falls
# back to Vercel's own deployment hostname (VERCEL_PROJECT_PRODUCTION_URL, then
# VERCEL_URL) and finally to localhost — see src/lib/site.ts. Those fallbacks
# keep a deployment self-consistent, but only this variable survives a domain
# change, so set it explicitly once the custom domain is attached.
#
# No trailing slash. A bare hostname is accepted and upgraded to https://.
NEXT_PUBLIC_SITE_URL=https://novixa.dev

# ------------------------------------------------------------------------------
# Transactional email for the "Start a Project" contact form.
# ------------------------------------------------------------------------------
# Get a key at https://resend.com. Leave empty in local development to log
# submissions to the console instead of sending mail; the API then responds
# with `delivered: false` so the UI never claims a message was sent when it
# was not.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend, otherwise sends are
# rejected. onboarding@resend.dev works for testing only.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where "Start a Project" submissions are delivered.
NOVIXA_CONTACT_EMAIL=hello@novixa.dev

# ------------------------------------------------------------------------------
# Public contact channels (client-side, so they must be NEXT_PUBLIC_*).
# ------------------------------------------------------------------------------
# WhatsApp: digits only, full international form without "+", e.g. 967771234567.
# The channel is NOT rendered while this is empty — deliberately. A link to a
# number nobody owns sends visitors to a dead chat, which reads worse than one
# fewer contact option.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Overrides the contact address shown in the UI. Defaults to hello@novixa.dev.
NEXT_PUBLIC_CONTACT_EMAIL=

# ------------------------------------------------------------------------------
# Optional: field Core Web Vitals reporting.
# ------------------------------------------------------------------------------
# When set, real-visit LCP/CLS/INP measurements are POSTed here (see
# src/components/common/WebVitals.tsx). Leave empty to report nothing.
#
# Not using @vercel/speed-insights: it carries an optional @sveltejs/kit peer
# dependency that collides with the Vite version Vitest pins in this tree, so
# installing it would require --legacy-peer-deps for the whole project.
NEXT_PUBLIC_VITALS_ENDPOINT=
