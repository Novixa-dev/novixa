# ==============================================================================
# Novixa Environment Template (.env.example)
# Copy to .env.local for local development. Never commit real secret values.
# ==============================================================================

# Public site URL — used for canonical URLs, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://novixa.dev

# Resend (transactional email for the "Start a Project" contact form).
# Get a key at https://resend.com — leave empty in local dev to log submissions
# to the console instead of sending email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where "Start a Project" submissions are delivered.
NOVIXA_CONTACT_EMAIL=hello@novixa.dev
